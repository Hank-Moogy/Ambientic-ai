{
  "name": "claude-controller",
  "version": "0.8.0",
  "description": "Floating APC40-style controller that monitors your Claude Code / Codex / Kimi terminal sessions and lets you jump to the one that needs you.",
  "author": "findmecreators",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "install-hooks": "sh hook/install.sh",
    "pack": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "vite": "^5.4.11"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "build": {
    "appId": "com.findmecreators.claudecontroller",
    "productName": "Claude Controller",
    "directories": { "output": "release" },
    "files": ["out/**/*"],
    "extraResources": [
      { "from": "hook", "to": "hook" }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": ["dmg"],
      "extendInfo": { "LSUIElement": true }
    }
  }
}
