{
  "name": "ambientic",
  "version": "0.8.1",
  "description": "Local-first APC40 MKII control surface for Claude Code, Codex, and Hermes agent sessions.",
  "author": "findmecreators",
  "main": "out/main/index.js",
  "scripts": {
    "test": "node --test test/*.mjs",
    "test:local-release": "node --test --test-skip-pattern='keeps Claude OAuth callback alive until live auth verification succeeds' test/*.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "rebuild:sqlite:node": "node scripts/rebuild-sqlite-node.mjs",
    "rebuild:sqlite": "node scripts/rebuild-sqlite.mjs",
    "test:sqlite": "ELECTRON_RUN_AS_NODE=1 electron scripts/sqlite-smoke.mjs",
    "test:sqlite:packaged": "node scripts/sqlite-packaged-smoke.mjs",
    "preview": "electron-vite preview",
    "release:local": "node scripts/release-local.mjs",
    "install-hooks": "sh hook/install.sh",
    "pack": "npm run rebuild:sqlite && npm run test:sqlite && electron-vite build && electron-builder --dir",
    "dist": "npm run rebuild:sqlite && npm run test:sqlite && electron-vite build && electron-builder"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "vite": "^5.4.11"
  },
  "dependencies": {
    "@julusian/midi": "^3.6.1",
    "better-sqlite3": "^11.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "build": {
    "appId": "com.findmecreators.ambientic",
    "productName": "Ambientic",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/build/Release/*.node"
    ],
    "extraResources": [
      {
        "from": "hook",
        "to": "hook"
      },
      {
        "from": "resources/claude_pty.py",
        "to": "claude_pty.py"
      },
      {
        "from": "resources/claude_usage.py",
        "to": "claude_usage.py"
      },
      {
        "from": "resources/ambientic-logo.png",
        "to": "ambientic-logo.png"
      },
      {
        "from": "resources/build-info.json",
        "to": "build-info.json"
      },
      {
        "from": "resources/ambientic-mcp-shim.mjs",
        "to": "ambientic-mcp-shim.mjs"
      }
    ],
    "mac": {
      "icon": "build/ambientic-icon-1024.png",
      "category": "public.app-category.developer-tools",
      "identity": "Apple Development: samori.osei@gmail.com (N72VQSKU6T)",
      "type": "development",
      "target": [
        "dmg"
      ],
      "extendInfo": {
        "LSUIElement": false,
        "NSMicrophoneUsageDescription": "Ambientic records voice prompts locally when you press Record on your APC40 MKII."
      }
    }
  }
}
